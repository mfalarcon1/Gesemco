# Conexión a PostgreSQL. Ajusta usuario, contraseña, puerto y nombre de la base.
# El puerto por defecto de PostgreSQL es 5432; revisa cuál usa tu instalación.
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/gesemco"

